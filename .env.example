# Required only for discovery (the LLM-driven run). Replay and tests never need it.
ANTHROPIC_API_KEY=

# Optional. Set this to route Anthropic API calls through a compatible proxy/gateway
# (e.g. an Azure AI Foundry endpoint exposing the Anthropic Messages API at .../anthropic).
# Leave blank to call the Anthropic API directly.
ANTHROPIC_BASE_URL=

# Anthropic model id used for discovery.
MODEL=claude-sonnet-4-6

# Fake credentials the mock app ("CU Console") accepts. Never real credentials.
DEMO_USER=teller
DEMO_PASS=demo-pass

# Optional. Set to "b" to run the mock app's second-tenant variant (different branding/routes).
TENANT=

# Port the mock app listens on.
PORT=4173

# Chrome DevTools Protocol remote-debugging port used to share a live browser session
# between the automation process and the operator CLI during human escalation.
CDP_PORT=9222
